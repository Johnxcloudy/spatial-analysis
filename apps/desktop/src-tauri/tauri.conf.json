{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spatial Analysis Desktop",
  "version": "0.1.0",
  "identifier": "com.johnxcloudy.spatialanalysis",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spatial Analysis Desktop",
        "width": 1320,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560,
        "backgroundColor": "#f4f6f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {"resources/engine/": "engine/"},
    "windows": {
      "webviewInstallMode": {"type": "offlineInstaller"},
      "nsis": {"installMode": "currentUser", "displayLanguageSelector": true, "languages": ["SimpChinese", "English"]}
    }
  }
}
